{
  "expo": {
    "name": "MUSICAGE",
    "slug": "musicage",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "周囲で流れている音楽に反応する映像を表示するためにマイクを使用します。曲の識別にはShazamKitを使い、音声は保存しません。",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "expo-status-bar"
    ]
  }
}
